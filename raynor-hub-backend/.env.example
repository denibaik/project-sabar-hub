# Salin ke .env lalu isi dengan nilai ACAK PANJANG milikmu. JANGAN commit .env.
# Membuat nilai acak:  python -c "import secrets; print(secrets.token_urlsafe(32))"

DATABASE_URL=sqlite:///./data/sqlite/sabar_hub.db   # produksi: postgresql+psycopg://user:pass@host/db

# --- Kunci (WAJIB diganti sebelum deploy) ---
ADMIN_API_KEY=ganti-dengan-acak-panjang         # dashboard → semua endpoint kelola (via proxy Next.js)
BOT_REGISTRATION_KEY=ganti-dengan-acak-panjang  # server dashboard saat admin membuat bot baru.
                                                # TIDAK pernah masuk ke script bot / browser.

# --- CORS: origin dashboard, pisah koma ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # VPS: https://dashboard.domainmu.com

# --- Perilaku order ---
HEARTBEAT_TIMEOUT_SECONDS=60   # bot dianggap offline setelah sekian detik tanpa heartbeat
ORDER_RETRY_DELAY_SECONDS=15   # jeda sebelum order 'released' boleh diklaim lagi
ORDER_MAX_RELEASE=8            # setelah sekian kali dilepas → tandai failed

# --- Backorder sweeper (order pending tak terpenuhi → failed) ---
ORDER_STALE_SECONDS=900        # umur order sebelum dianggap kedaluwarsa (0 = matikan)
SWEEPER_INTERVAL_SECONDS=60    # seberapa sering sweeper jalan

# --- Rate limit per IP per menit (0 = matikan). Hitungan per-proses uvicorn. ---
RATE_LIMIT_PUBLIC=120          # /health, /files/*
RATE_LIMIT_BOT=600             # heartbeat + claim + result
RATE_LIMIT_ADMIN=600           # endpoint dashboard

# --- U7Buy (marketplace) ---
U7BUY_APP_ID=                       # dari portal seller U7Buy
U7BUY_APP_SECRET=                   # JANGAN dibagikan
U7BUY_BASE_URL=https://openapi.u7buy.com/prod-api
# Dokumentasi U7Buy tidak menyebut nama header tanda tangan webhook.
# Sesuaikan setelah melihat header webhook asli yang pertama masuk
# (log backend akan menampilkan seluruh header saat verifikasi gagal).
U7BUY_SIGNATURE_HEADER=x-signature
U7BUY_VERIFY_SIGNATURE=true         # sementara set false HANYA untuk mencocokkan format
U7BUY_GAME_NAME=Grow a Garden 2     # order game lain diabaikan; bot hanya ada di game ini
U7BUY_PROCESS_INTERVAL_SECONDS=60   # selang pemrosesan event tertunda; 0 = matikan
# Menandai order Delivering/Completed di U7Buy setelah bot mengirim.
# MATI secara default: ini mengubah order pembeli yang sesungguhnya.
# Nyalakan hanya setelah alurnya terbukti benar pada order uji.
U7BUY_CALLBACK_ENABLED=false
# Menulis ulang stok listing di U7Buy agar sesuai stok bot.
# MATI secara default: listing memuat harga & deskripsi. Penulisan dilakukan
# dengan menyalin balik objek offer yang baru dibaca — hanya `inventory` yang
# diubah — tapi body PUT-nya tidak terdokumentasi, jadi uji satu listing dulu.
U7BUY_STOCK_SYNC_ENABLED=false

# --- Auto-sync Google Sheet ---
# Tarik order baru dari sheet tiap sekian detik (0 = matikan, sync manual saja).
SHEET_SYNC_INTERVAL_SECONDS=120

# --- Penangkap webhook generik (untuk mengetahui format pengirim baru) ---
# Rahasia ini jadi BAGIAN URL, karena pengirim seperti webhook Discord tidak bisa
# mengirim header khusus. Perlakukan URL-nya seperti kata sandi.
# Kosong = endpoint dimatikan sepenuhnya.
#   URL yang dipakai: https://api.domainmu.com/api/v1/webhooks/capture/<token>/<label>
CAPTURE_WEBHOOK_TOKEN=

# Alamat backend yang dipakai BOT. Disuntikkan ke script saat disajikan lewat
# /files/loader.lua, jadi file di repo TIDAK perlu diedit di server (editan
# seperti itu membuat `git pull` bentrok tiap ada pembaruan).
PUBLIC_API_URL=https://api.domainmu.com
