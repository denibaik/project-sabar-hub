# Salin ke .env.local dan isi. JANGAN commit .env.local.
#
# Server-only — TIDAK sampai ke browser (jangan pakai prefix NEXT_PUBLIC):
BACKEND_URL=http://127.0.0.1:8000        # alamat backend FastAPI (di VPS: internal/localhost)
ADMIN_API_KEY=ganti-dengan-acak-panjang  # = admin_api_key backend; dipakai proxy
BOT_REGISTRATION_KEY=ganti-dengan-acak   # = bot_registration_key backend
DASHBOARD_PASSWORD=ganti-password-kuat   # password login dashboard
SESSION_SECRET=ganti-string-acak-panjang # penanda-tangan cookie sesi

# Publik — boleh sampai ke browser:
NEXT_PUBLIC_LOADER_URL=https://api.domainmu.com/files/loader.lua
