# Salin ke .env lalu isi dengan nilai ACAK PANJANG milikmu. JANGAN commit .env.
# Membuat nilai acak:  python -c "import secrets; print(secrets.token_urlsafe(32))"

DATABASE_URL=sqlite:///./data/sqlite/sabar_hub.db   # produksi: postgresql+psycopg://user:pass@host/db

# --- Kunci (WAJIB diganti sebelum deploy) ---
ADMIN_API_KEY=ganti-dengan-acak-panjang         # dashboard → semua endpoint kelola (via proxy Next.js)
BOT_REGISTRATION_KEY=ganti-dengan-acak-panjang  # server dashboard saat admin membuat bot baru.
                                                # TIDAK pernah masuk ke script bot / browser.

# --- CORS: origin dashboard, pisah koma ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # VPS: https://dashboard.domainmu.com

# --- Perilaku order ---
HEARTBEAT_TIMEOUT_SECONDS=60   # bot dianggap offline setelah sekian detik tanpa heartbeat
ORDER_RETRY_DELAY_SECONDS=15   # jeda sebelum order 'released' boleh diklaim lagi
ORDER_MAX_RELEASE=8            # setelah sekian kali dilepas → tandai failed

# --- Backorder sweeper (order pending tak terpenuhi → failed) ---
ORDER_STALE_SECONDS=900        # umur order sebelum dianggap kedaluwarsa (0 = matikan)
SWEEPER_INTERVAL_SECONDS=60    # seberapa sering sweeper jalan

# --- Rate limit per IP per menit (0 = matikan). Hitungan per-proses uvicorn. ---
RATE_LIMIT_PUBLIC=120          # /health, /files/*
RATE_LIMIT_BOT=600             # heartbeat + claim + result
RATE_LIMIT_ADMIN=600           # endpoint dashboard
