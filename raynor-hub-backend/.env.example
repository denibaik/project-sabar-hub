# Salin ke .env dan isi. JANGAN commit .env.
DATABASE_URL=sqlite:///./data/sqlite/sabar_hub.db   # di produksi: postgresql://user:pass@host/db
BOT_REGISTRATION_KEY=ganti-dengan-acak-panjang       # dipakai bot utk register
ADMIN_API_KEY=ganti-dengan-acak-panjang              # dipakai dashboard (via proxy Next.js)
HEARTBEAT_TIMEOUT_SECONDS=60
ORDER_RETRY_DELAY_SECONDS=15
ORDER_MAX_RELEASE=8
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # di VPS: https://dashboard.domainmu.com
